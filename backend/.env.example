# Copie para .env e ajuste os valores antes de rodar em qualquer ambiente real.
#
# Todos os valores abaixo têm default no código e servem para desenvolvimento
# como estão: `cp .env.example .env` e a aplicação sobe. O que muda em produção
# é declarado, e o que for esquecido a aplicação recusa (ver AMBIENTE).

# Qual ambiente está rodando: desenvolvimento, teste ou producao.
# Fora de desenvolvimento/teste a aplicação RECUSA SUBIR com a SECRET_KEY de
# exemplo abaixo. Um valor fora dessa lista (um "prod" digitado com pressa)
# também é recusado, com a lista na mensagem.
AMBIENTE=desenvolvimento

DATABASE_URL=sqlite:///./app.db

# ATENÇÃO: esta chave está no repositório, logo não é segredo de ninguém. Quem
# a tem assina um token válido de qualquer aluno. Para AMBIENTE=producao, gere
# uma própria e a aplicação não sobe enquanto isso não for feito:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-e-secreto

ALGORITHM=HS256

# Origens que o navegador pode usar para chamar esta API, separadas por vírgula.
# Em produção entra aqui o endereço do frontend publicado (com https), e mais de
# um se houver: ORIGENS_PERMITIDAS=https://mapface.exemplo.br,https://www.mapface.exemplo.br
# O curinga "*" é recusado: a API responde com credenciais, e nessa combinação o
# próprio navegador rejeita a resposta.
ORIGENS_PERMITIDAS=http://localhost:4200

# Nível mínimo das linhas de log (DEBUG, INFO, WARNING, ERROR). O log sai em
# JSON, uma linha por evento, no stdout.
NIVEL_DE_LOG=INFO

# Janela de validade de um token. Ela desliza: enquanto o aluno usa o sistema,
# o cliente troca o token por outro em POST /auth/renovar antes de vencer.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Teto absoluto da credencial, contado do login e carimbado no token. É o que
# impede a janela deslizante de virar credencial eterna. Um dia de estudo cabe;
# um fim de semana esquecido não.
TETO_DE_CREDENCIAL_HORAS=12
# Maior vão entre dois pontos da série ainda atribuível a perda de captura.
# (Nome antigo: SESSAO_INATIVIDADE_MINUTOS, ainda aceito.)
VAO_MAXIMO_DA_SERIE_MINUTOS=10
